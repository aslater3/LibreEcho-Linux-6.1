# Radar-Puffin MT8163 thermal control.
#
# The energy model is what makes cpufreq cooling a power actor; without it
# power_allocator refuses to bind. Combined with dynamic-power-coefficient in
# the device tree, this gives the CPU cooling device a power model.
CONFIG_ENERGY_MODEL=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# Deliberately NOT CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR.
#
# thermal_zone_device_register() treats a failed governor bind as fatal to the
# zone -- it jumps straight to unregister -- so if the energy model does not
# come up for any reason, making power_allocator the default would take the
# whole cpu-thermal zone with it, including the critical trip. That is worse
# than the problem being solved.
#
# step_wise stays the default, which keeps the safe path at boot and still
# throttles at the target trip. Switching a single zone is reversible at
# runtime, and a failed switch falls back to the previous governor rather than
# unregistering anything:
#
#     echo power_allocator > /sys/class/thermal/thermal_zone0/policy
#
# Flip the default here once that has been confirmed on hardware.
CONFIG_THERMAL_GOV_STEP_WISE=y
